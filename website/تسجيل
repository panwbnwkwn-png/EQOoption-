<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EQOoption</title>
<style>
*{box-sizing:border-box}
body{
margin:0;min-height:100vh;font-family:Arial,Tahoma;
background:linear-gradient(135deg,#071321,#102b3b);
color:white;display:flex;align-items:center;justify-content:center;
padding:20px
}
.container{
width:100%;max-width:950px;display:grid;
grid-template-columns:1fr 1fr;background:#101e30;
border:1px solid #263b52;border-radius:22px;overflow:hidden
}
.info{padding:45px;background:#102c3a}
.logo{font-size:27px;font-weight:bold;color:#32d6a5}
.info h1{font-size:34px;line-height:1.5;margin-top:65px}
.info p{color:#b8c9d8;line-height:2}
.form{padding:45px}
h2{margin-top:0}
input{
width:100%;padding:15px;margin:10px 0 18px;
border:1px solid #344a62;border-radius:9px;
background:#091626;color:white;font-size:16px
}
button{
width:100%;padding:15px;border:0;border-radius:9px;
background:#27d3a2;color:#06251d;font-size:17px;
font-weight:bold;cursor:pointer
}
.tabs{display:flex;gap:10px;margin:25px 0}
.tabs button{background:#20344a;color:white}
.tabs button.active{background:#27d3a2;color:#06251d}
.note{font-size:12px;color:#9aabc2;line-height:1.8}
@media(max-width:700px){
.container{grid-template-columns:1fr}
.info,.form{padding:28px}
.info h1{margin-top:25px;font-size:27px}
}
</style>
</head>
<body>
<div class="container">
<section class="info">
  <div class="logo">EQOoption</div>
  <h1>مرحباً بك في منصتك التعليمية</h1>
  <p>تعلّم فهم الأسواق وتدرّب على الصفقات في بيئة محاكاة برصيد افتراضي.</p>
  <p>منصة تعليمية تجريبية وليست للتداول بأموال حقيقية.</p>
</section>

<section class="form">
  <h2 id="heading">تسجيل الدخول</h2>
  <div class="tabs">
   <button type="button" class="active" id="loginTab">دخول</button>
   <button type="button" id="registerTab">حساب جديد</button>
  </div>

  <form id="authForm">
   <div id="nameBox" hidden>
    <label>الاسم الكامل</label>
    <input id="name" type="text" placeholder="اسمك">
   </div>

   <label>البريد الإلكتروني</label>
   <input id="email" type="email" required placeholder="البريد الإلكتروني">

   <label>كلمة المرور</label>
   <input id="password" type="password" required minlength="8"
          placeholder="8 أحرف على الأقل">

   <button id="submitBtn" type="submit">تسجيل الدخول</button>
  </form>
  <p id="message" class="note"></p>
  <p class="note">واجهة تجريبية. لم يتم تفعيل تسجيل الحسابات قبل ربط نظام المصادقة.</p>
</section>
</div>

<script>
const loginTab=document.getElementById('loginTab');
const registerTab=document.getElementById('registerTab');
const nameBox=document.getElementById('nameBox');
const heading=document.getElementById('heading');
const submitBtn=document.getElementById('submitBtn');
const message=document.getElementById('message');
let mode='login';

function setMode(value){
mode=value;
const registering=mode==='register';
nameBox.hidden=!registering;
heading.textContent=registering?'إنشاء حساب جديد':'تسجيل الدخول';
submitBtn.textContent=registering?'إنشاء الحساب':'تسجيل الدخول';
loginTab.classList.toggle('active',!registering);
registerTab.classList.toggle('active',registering);
message.textContent='';
}
loginTab.onclick=()=>setMode('login');
registerTab.onclick=()=>setMode('register');

document.getElementById('authForm').onsubmit=function(e){
e.preventDefault();
message.textContent='الواجهة تعمل تجريبياً. يلزم ربط Supabase لتفعيل الحسابات فعلياً.';
};
</script>
</body>
</html>
